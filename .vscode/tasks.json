{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build PC server",
			"type": "shell",
			"command": "powershell",
			"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-pc.ps1"],
			"group": "build"
		},
		{
			"label": "Build Android APK",
			"type": "shell",
			"command": "powershell",
			"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-android.ps1"],
			"group": "build"
		},
		{
			"label": "Build and install Android APK (adb)",
			"type": "shell",
			"command": "powershell",
			"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build-android-adb.ps1"],
			"group": "build"
		},
		{
			"label": "Test protocol",
			"type": "shell",
			"command": "dotnet",
			"args": ["test", "${workspaceFolder}/pc-server.Tests"],
			"group": "test"
		}
	]
}
