<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_app_dark">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Mando Bluetooth"
        android:textColor="@color/text_app_dark" />

    <Spinner
        android:id="@+id/spDevices"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="IP del PC" android:layout_marginTop="12dp"
        android:textColor="@color/text_app_dark"/>

    <EditText
        android:id="@+id/etIp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="192.168.1.100" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Puerto" android:layout_marginTop="12dp"
        android:textColor="@color/text_app_dark"/>

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number"
        android:text="39500" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Conectar" android:layout_marginTop="16dp" />

    <CheckBox
        android:id="@+id/chkBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seguir en segundo plano (notificación) y capturar mando sin afectar otras apps" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Desconectado" android:layout_marginTop="12dp"
        android:textColor="@color/text_app_dark" />

    <Button
        android:id="@+id/btnScreenOff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apagar/Encender pantalla (simulado)"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnDarkMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alternar modo oscuro"
        android:layout_marginTop="8dp" />
</LinearLayout>
